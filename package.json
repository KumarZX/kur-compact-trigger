{
  "name": "kur-compact-trigger",
  "version": "1.2.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "DSH plugin: per-session compaction (official auto is global-only). Compact cheap chats without keeping Settings open.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "compaction",
    "context-compression"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KumarZX/kur-compact-trigger.git"
  },
  "homepage": "https://github.com/KumarZX/kur-compact-trigger#readme",
  "bugs": {
    "url": "https://github.com/KumarZX/kur-compact-trigger/issues"
  },
  "author": "KumarZX",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
